# LINE Messaging API
# LINE Developers (https://developers.line.biz/) から取得
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# エスカレーション通知の送信先ユーザーID（オーナーの LINE userId）
LINE_OWNER_USER_ID=your_line_user_id_here

# Supabase
# https://supabase.com から作成したプロジェクトから取得
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Claude API
# https://console.anthropic.com から取得
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 管理画面（/admin, /api/admin）の Basic 認証
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_admin_password_here
